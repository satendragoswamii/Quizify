# Quizify configuration — copy to `.env` and fill in only what you need.
#   cp .env.example .env
# Every setting is optional. With nothing set, Quizify runs fully offline using
# its rule-based parser. Most settings can also be changed later in /admin, which
# takes precedence over this file.

# =============================================================================
# AI assist (all optional)
# =============================================================================
# Set a key for any provider below and Quizify will use it. Several keys means
# automatic failover: if one is rate-limited or down, the next one is tried.

# --- Free tiers ---
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=

# --- Paid ---
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=

# --- Custom OpenAI-compatible endpoint (e.g. OpenCode) ---
# QUIZ_API_ENABLED=false
# QUIZ_API_ENDPOINT=https://api.example.com/v1/chat/completions
# QUIZ_API_KEY=
# QUIZ_API_MODEL=
# QUIZ_API_TIMEOUT=60

# --- Local, no key, no cost ---
# QUIZ_ENABLE_OLLAMA=true
# OLLAMA_HOST=http://localhost:11434

# --- Tuning ---
# QUIZ_AI_PROVIDERS=openrouter,groq,gemini     # order to try providers in
# QUIZ_MODEL_OPENROUTER=
# QUIZ_MODEL_GROQ=
# QUIZ_MODEL_ANTHROPIC=
# QUIZ_AI_TIMEOUT=90
# QUIZ_AI_RETRIES=2

# =============================================================================
# Admin panel & security
# =============================================================================
# Visit /admin on first run to create the administrator account.

# QUIZ_DB_PATH=./quizify.db
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# QUIZ_SECRET_KEY=
# QUIZ_SECURE_COOKIES=true      # set true when served over HTTPS
# QUIZ_SESSION_HOURS=12

# --- App limits ---
# QUIZ_MAX_UPLOAD_MB=25
# QUIZ_LOG_LEVEL=INFO

# --- Serving behind a reverse proxy (nginx, Caddy, load balancer) ---
# QUIZ_PROXY_HOPS=1

# =============================================================================
# MessengerX.io companion (optional) — powers the in-app help chat
# =============================================================================
# MESSENGERX_API_KEY=
# MESSENGERX_USER_ID=
# MESSENGERX_SLUG=
# MESSENGERX_CHAT_PATH=
